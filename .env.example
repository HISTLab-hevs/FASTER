# Public HTTPS entrypoint
HTTPS_PORT=8443
NGINX_SERVER_NAME=localhost
TLS_CERT_FILENAME=localhost.crt
TLS_KEY_FILENAME=localhost.key
NGINX_CLIENT_MAX_BODY_SIZE=1024m   # max request body the proxy accepts (dataset uploads)

# Shared DB engine
MARIADB_ROOT_PASSWORD=change-root-password
MARIADB_DATABASE=faster
MARIADB_USER=faster_app
MARIADB_PASSWORD=change-faster-db-password   # FASTER_DB_PASSWORD and JM_DB_PASSWORD must be set to this same value

# FASTER app DB
FASTER_STORAGE_MODE=database
FASTER_DB_HOST=mariadb
FASTER_DB_PORT=3306
FASTER_DB_USER=faster_app
FASTER_DB_PASSWORD=change-faster-db-password   # same value as MARIADB_PASSWORD
FASTER_DB_NAME=faster
FASTER_DB_CONNECT_TIMEOUT=8        # seconds to wait when opening a DB connection
FASTER_DB_POOL_SIZE=10             # persistent DB connections kept open and reused; raise only if requests queue under load (must be > 0)

# Upload limits in bytes (0 = unlimited)
FL_API_BODY_MAX_BYTES=0            # cap on POST /api request bodies
FL_CUSTOM_DATASET_UPLOAD_MAX_BYTES=0   # cap on streamed custom-dataset uploads

# FASTER auth secret (HS256: use a long random value, >= 32 bytes)
FL_SECRET_KEY=replace-with-long-random-secret-1234567890

# Bootstrap admin, seeded only when the users table is empty.
# Password policy: >=10 chars, upper, lower, digit, special.
FASTER_ADMIN_USERNAME=admin
FASTER_ADMIN_PASSWORD=StrongAdminPass123!
# FASTER_ADMIN_EMAIL=admin@example.com

# Job Manager DB
JM_DB_HOST=mariadb
JM_DB_PORT=3306
JM_DB_USER=faster_app
JM_DB_PASSWORD=change-faster-db-password   # same value as MARIADB_PASSWORD
JM_DB_NAME=faster
JM_ADMIN_PASSWORD=admin123
JM_JWT_SECRET=replace-with-job-manager-jwt-secret

# faster-app <-> Job Manager bridge (service account, kept distinct from the admin)
JM_API_BASE_URL=http://job-manager-api:5000
JM_API_TIMEOUT=8                   # seconds before a Job Manager API call times out
JM_SERVICE_USERNAME=svc-faster
JM_SERVICE_PASSWORD=StrongServicePass123!
FL_JM_SOURCE_APP=faster
